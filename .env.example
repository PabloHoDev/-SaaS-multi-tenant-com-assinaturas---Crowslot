# Copie para .env e preencha os valores.

# Banco (Neon, Supabase ou local via docker compose)
# DATABASE_URL: usada pela aplicação (no Neon, a URL com "-pooler" no host).
# DIRECT_URL: usada pelas migrations (no Neon, a URL sem "-pooler"). Opcional em banco local.
DATABASE_URL="postgresql://crowslot:crowslot@localhost:5432/crowslot"
DIRECT_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (login por link mágico e convites). Sem chave, os e-mails são impressos no terminal.
RESEND_API_KEY=""
EMAIL_FROM="Crowslot <onboarding@resend.dev>"

# Stripe (modo teste)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
